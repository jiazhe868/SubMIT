bg_timeP= -20 #begining time of inverse time window (P)
nd_timeP= 42 #ending time of inverse time window (shrunk to cen_max+dura_max+15)
bg_timeSH= -20 #begining time of inverse time window (SH)
nd_timeSH= 42 #ending time of inverse time window (shrunk to cen_max+dura_max+15)
bg_timeRayl= -20 #begining time of inverse time window (SH)
nd_timeRayl= 210 #ending time of inverse time window (SH)
stf_btime= -12 #begining time of source time function time window
stf_etime= 46 #ending time of source time function time window
deltat= 1.0 #sampling rate of data (from programs/submit.conf)
num_sta_P= 140 #Number of all stations (P)
num_sta_SH= 67 #Number of all stations (SH)
num_sta_Rayl= 83 #Number of all stations (P)
stainfofileP= stations.info #Station distance (in degree) and azimuth (P)
stainfofileSH= stationsSH.info #Station distance (in degree) and azimuth (SH)
stainfofileRayl= stationsloc.info
weightP= 2.07727 #
weightSH= 1 #
weightRayl= 0.00136843
InputModelFile= Input.model #Input model parameters
num_subevent= 6 #Number of subevents in input model
Low_frequencyP= 0.005 #Lower frequency bound in Hz (P)
High_frequencyP= 0.2 #Lower frequency bound in Hz (P)
Low_frequencySH= 0.005 #Lower frequency bound in Hz (SH)
High_frequencySH= 0.2 #Lower frequency bound in Hz (SH)
Low_frequencyRayl= 0.02 #Lower frequency bound in Hz (P)
High_frequencyRayl= 0.15 #Lower frequency bound in Hz (P)
Tikhonov_alpha= 5e-4 #Parameter for Tikhonov regularization, try using values between 1e-4 to 1e-3 first
CMTscaling= 3 #Parameter for CMT scaling, ~ >1e-5: start to have constraints on total MT
evlo= -125.0252
evla= 40.36983
evvp= 5.8 #Average Vp near the source depth
evvs= 3.4  #Average Vs near the source depth
DCconstrain= 1 #DC constrain: 2-weak, 0.5-strong
bg_localdist= 2  # begining distance for local stations (km)
nd_localdist= 418 # ending distance for local stations (km)
localdist_interval= 2  # distace interval for local stations (km)
bg_depth= 3 # begining depth in the search (km).
nd_depth= 19 # ending depth in the search (km).
depth_interval= 2 # depth interval in the seach (km).
maxshftP= 2 # max allowable time shift (s) for P cross-correlation alignment
maxshftSH= 5 # max allowable time shift (s) for SH
maxshftRayl= 7 # max shift (s) for local waves: 10% velocity error x max distance / 3 km/s
greenchar1= ../gf_2024-12-05-mww70-off-coast-of-northern/greenFuncDir_disp/vmodel_ # "greenchar" series are the format of green's function paths. For example, if the path was "greenFuncDir/vmodel_20/5871.grn." for depth=20km and dist=5871km, then greenchar1="greenFuncDir/vmodel_", greenchar2="/", greenchar3=".grn."
greenchar2= / # See details for greenchar1
greenchar3= .grn. # See details for greenchar1
TotalMomentTensor= totalmt.dat #moment tensor summation should be consistent with point source solution. Unit is 1e27 dyne-cm
