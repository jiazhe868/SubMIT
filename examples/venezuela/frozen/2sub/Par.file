bg_timeP= -20 #begining time of inverse time window (P)
nd_timeP= 157 #ending time of inverse time window (P)
bg_timeSH= -20 #begining time of inverse time window (SH)
nd_timeSH= 157 #ending time of inverse time window (SH)
bg_timeRayl= -20 #begining time of inverse time window (SH)
nd_timeRayl= 360 #ending time of inverse time window (SH)
stf_btime= -14 #begining time of source time function time window
stf_etime= 147 #ending time of source time function time window
deltat= 1.0 #sampling rate of data (from programs/submit.conf)
num_sta_P= 120 #Number of all stations (P)
num_sta_SH= 56 #Number of all stations (SH)
num_sta_Rayl= 6 #Number of all stations (P)
stainfofileP= stations.info #Station distance (in degree) and azimuth (P)
stainfofileSH= stationsSH.info #Station distance (in degree) and azimuth (SH)
stainfofileRayl= stationsloc.info
weightP= 3.37849 #
weightSH= 1 #
weightRayl= 0.0732932
InputModelFile= Input.model #Input model parameters
num_subevent= 6 #Number of subevents in input model
Low_frequencyP= 0.005 #Lower frequency bound in Hz (P)
High_frequencyP= 0.1 #Lower frequency bound in Hz (P)
Low_frequencySH= 0.005 #Lower frequency bound in Hz (SH)
High_frequencySH= 0.1 #Lower frequency bound in Hz (SH)
Low_frequencyRayl= 0.02 #Lower frequency bound in Hz (P)
High_frequencyRayl= 0.05 #Lower frequency bound in Hz (P)
Tikhonov_alpha= 5e-4 #Parameter for Tikhonov regularization, try using values between 1e-4 to 1e-3 first
CMTscaling= 3 #Parameter for CMT scaling, ~ >1e-5: start to have constraints on total MT
evlo= -68.5277
evla= 10.436
evvp= 6.5 #Average Vp near the source depth
evvs= 3.9  #Average Vs near the source depth
DCconstrain= 1 #DC constrain: 2-weak, 0.5-strong
bg_localdist= 79  # begining distance for local stations (km)
nd_localdist= 949 # ending distance for local stations (km)
localdist_interval= 5  # distace interval for local stations (km)
bg_depth= 3 # begining depth in the search (km).
nd_depth= 39 # ending depth in the search (km).
depth_interval= 2 # depth interval in the seach (km).
maxshftP= 2 # max allowable time shift (s) for P cross-correlation alignment
maxshftSH= 5 # max allowable time shift (s) for SH
maxshftRayl= 20 # max shift (s) for local waves: 10% velocity error x max distance / 3 km/s
greenchar1= ../gf_2026-06-24-mww72-near-coast-of-venezuela/greenFuncDir_disp/vmodel_ # "greenchar" series are the format of green's function paths. For example, if the path was "greenFuncDir/vmodel_20/5871.grn." for depth=20km and dist=5871km, then greenchar1="greenFuncDir/vmodel_", greenchar2="/", greenchar3=".grn."
greenchar2= / # See details for greenchar1
greenchar3= .grn. # See details for greenchar1
TotalMomentTensor= totalmt.dat #moment tensor summation should be consistent with point source solution. Unit is 1e27 dyne-cm
